generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  name           String
  phone          String?
  avatarUrl      String?
  telegramChatId String?
  passwordHash   String
  role           UserRole @default(DOCTOR)
  isActive       Boolean  @default(true)
  status         AccountStatus @default(ACTIVE)
  sessions       Session[]
  doctorId       String?  @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  doctor         Doctor?  @relation(fields: [doctorId], references: [id])

  @@index([role])
}

model Service {
  id               String        @id @default(uuid())
  name             String
  slug             String        @unique
  description      String?
  shortDescription String?
  price            Int           @default(0)
  durationMin      Int           @default(30)
  category         String
  imageUrl         String?
  keywords         String?
  sortOrder        Int           @default(0)
  isActive         Boolean       @default(true)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  appointments     Appointment[]

  @@index([category])
  @@index([isActive])
  @@index([slug])
}

model Doctor {
  id                     String                        @id @default(uuid())
  name                   String
  specialty              String
  title                  String?
  description            String?
  experience             Int                           @default(5)
  phone                  String?
  email                  String?
  telegramChatId         String?
  avatarUrl              String?
  imageUrl               String?
  isActive               Boolean                       @default(true)
  sortOrder              Int                           @default(0)
  createdAt              DateTime                      @default(now())
  updatedAt              DateTime                      @updatedAt
  appointments           Appointment[]
  availabilityExceptions DoctorAvailabilityException[]
  schedules              DoctorSchedule[]
  user                   User?

  @@index([isActive])
}

model DoctorSchedule {
  id        String  @id @default(uuid())
  doctorId  String
  dayOfWeek Int
  startTime String
  endTime   String
  isActive  Boolean @default(true)
  isDayOff  Boolean @default(false)
  doctor    Doctor  @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@unique([doctorId, dayOfWeek])
  @@index([doctorId])
}

model DoctorAvailabilityException {
  id        String                 @id @default(uuid())
  doctorId  String
  date      DateTime
  type      DoctorAvailabilityType @default(BLOCKED_RANGE)
  startTime String?
  endTime   String?
  reason    String?
  isActive  Boolean                @default(true)
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt
  doctor    Doctor                 @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId, date])
}

model Patient {
  id           String        @id @default(uuid())
  phone        String        @unique
  fullName     String
  email        String?
  age          Int?
  gender       Gender?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  appointments Appointment[]
  notes        PatientNote[]

  @@index([phone])
}

model Appointment {
  id              String            @id @default(uuid())
  patientName     String
  patientPhone    String
  patientEmail    String?
  note            String?
  chiefComplaint  String?
  appointmentDate DateTime
  startTime       String
  endTime         String
  status          AppointmentStatus @default(PENDING)
  isRepeat        Boolean           @default(false)
  doctorId        String?
  serviceId       String
  patientId       String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  doctor          Doctor?           @relation(fields: [doctorId], references: [id])
  patient         Patient?          @relation(fields: [patientId], references: [id])
  service         Service           @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  notes           AppointmentNote[]

  @@index([appointmentDate])
  @@index([doctorId, appointmentDate])
  @@index([patientPhone])
  @@index([status])
}

model AppointmentNote {
  id            String      @id @default(uuid())
  appointmentId String
  note          String
  author        String?
  createdAt     DateTime    @default(now())
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
}

model PatientNote {
  id        String   @id @default(uuid())
  patientId String
  note      String
  author    String?
  createdAt DateTime @default(now())
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
}

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model ClinicSetting {
  id        String   @id
  key       String   @unique
  value     String
  updatedAt DateTime

  @@index([key])
}

model Review {
  id          String   @id
  patientName String
  rating      Int      @default(5)
  comment     String
  serviceName String?
  isApproved  Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([isApproved])
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum UserRole {
  RECEPTION
  SUPER_ADMIN
  ADMIN
  DOCTOR
  PATIENT
}

enum DoctorAvailabilityType {
  DAY_OFF
  BLOCKED_RANGE
  SCHEDULE_OVERRIDE
}


enum AccountStatus {
  PENDING
  ACTIVE
  REJECTED
  SUSPENDED
}

model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AuthRateLimit {
  key       String   @id
  count     Int      @default(1)
  expiresAt DateTime

  @@index([expiresAt])
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  action    String
  entity    String
  entityId  String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([actorId, createdAt])
  @@index([createdAt])
}
