# Supabase Connect > Session pooler (5432) or Transaction pooler (6543)
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@REGION.pooler.supabase.com:6543/postgres?sslmode=require"
# Direct connection or Session pooler (5432) for migrations
DIRECT_URL="postgresql://postgres.PROJECT:PASSWORD@REGION.pooler.supabase.com:5432/postgres?sslmode=require"
APP_URL="http://localhost:3000"

# Booking notifications and Telegram password recovery; staff must start the bot.
TELEGRAM_BOT_TOKEN=""
# Optional seed admin email; public registration also supports first-admin setup
# Cloudinary image uploads (server-side only). Use URL or the three separate fields.
CLOUDINARY_URL=""
SETTINGS_ENCRYPTION_KEY=""
