# Runtime PostgreSQL connection (use the provider's pooled URL for serverless).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
# Optional direct connection for migrations.
DIRECT_URL=""
# Required server-only HMAC secret for shared authentication/booking rate limits.
# Generate locally: openssl rand -hex 32
AUTH_SECRET=""
# Canonical site origin, without a trailing path. If omitted, request origin is used.
APP_URL="http://localhost:3000"
# Images, including the clinic logo, are persisted in Cloudinary.
CLOUDINARY_URL="cloudinary://API_KEY:API_SECRET@CLOUD_NAME"
# Telegram recipients must first start the bot. Never expose the token to the browser.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
TELEGRAM_WEBHOOK_SECRET=""
# Optional public HTTPS origin that forwards to THIS server (e.g. a local HTTPS tunnel).
# Keep APP_URL as the browser's actual site origin; do not replace it with a tunnel URL.
TELEGRAM_WEBHOOK_BASE_URL=""
CRON_SECRET=""

# Development seed is disabled unless all three guards match. Never point it at production.
ALLOW_DEVELOPMENT_SEED="false"
SEED_DATABASE_NAME=""
SEED_STAFF_PASSWORD=""
SUPER_ADMIN_EMAIL=""
SUPER_ADMIN_PASSWORD=""
# Separate disposable database for opt-in integration tests.
TEST_DATABASE_URL=""
